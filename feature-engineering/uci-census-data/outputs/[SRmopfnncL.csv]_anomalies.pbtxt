baseline {
  feature {
    name: "age"
    type: INT
    int_domain {
      min: 17
      max: 90
    }
    drift_comparator {
      jensen_shannon_divergence {
        threshold: 0.1
      }
    }
  }
  feature {
    name: "workclass"
    type: BYTES
    domain: "workclass"
  }
  feature {
    name: "fnlwgt"
    type: INT
    presence {
      min_fraction: 1.0
      min_count: 1
    }
    shape {
      dim {
        size: 1
      }
    }
  }
  feature {
    name: "education"
    type: BYTES
    domain: "education"
  }
  feature {
    name: "education_num"
    type: INT
    int_domain {
      min: 1
    }
    drift_comparator {
      jensen_shannon_divergence {
        threshold: 0.1
      }
    }
  }
  feature {
    name: "marital_status"
